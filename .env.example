# Development: persistent local accounts and private local uploads.
# Production must use supabase + postgres; local mode is rejected in production.
NODE_ENV=development
AUTH_MODE=local
DATA_MODE=file
API_PORT=4000
WEB_ORIGIN=http://127.0.0.1:3000
API_INTERNAL_URL=http://127.0.0.1:4000
# Keep outside the public web directory. Generated automatically when absent.
DATA_DIRECTORY=
# Production / Supabase configuration. Never commit actual credentials.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=garments
DATABASE_URL=postgresql://fytts:fytts_local_only@127.0.0.1:5432/fytts?schema=public
DIRECT_URL=postgresql://fytts:fytts_local_only@127.0.0.1:5432/fytts?schema=public
# Optional multi-brand discovery. Server-only; never prefix with NEXT_PUBLIC_.
# Get your private key from https://serpapi.com/dashboard and check your plan allowance.
SERPAPI_API_KEY=
